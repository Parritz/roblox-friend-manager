{
	"manifest_version": 3,
	"name": "Roblox Friend Manager",
	"version": "1.0.0",
	"description": "Bulk-accept friend requests and bulk-unfriend on Roblox.",
	"icons": {
		"16": "assets/icon-16.png",
		"32": "assets/icon-32.png",
		"48": "assets/icon-48.png",
		"128": "assets/icon-128.png"
	},
	"permissions": ["storage", "alarms", "scripting"],
	"host_permissions": ["*://*.roblox.com/*"],
	"content_security_policy": {
		"extension_pages": "script-src 'self'; object-src 'self'; img-src 'self' data: https://*.rbxcdn.com https://*.roblox.com;"
	},
	"background": {
		"service_worker": "src/background/service-worker.js",
		"type": "module"
	},
	"action": {
		"default_popup": "src/popup/popup.html",
		"default_title": "Roblox Friend Manager",
		"default_icon": {
			"16": "assets/icon-16.png",
			"32": "assets/icon-32.png",
			"48": "assets/icon-48.png",
			"128": "assets/icon-128.png"
		}
	},
	"options_page": "src/options/options.html",
	"content_scripts": [
		{
			"matches": ["*://*.roblox.com/*"],
			"js": ["src/content/fetch-proxy.js"],
			"run_at": "document_idle",
			"all_frames": false
		}
	]
}

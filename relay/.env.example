# Copy to .env and edit. Loaded by `npm start` via --env-file.

# Required, 16+ chars. Generate one:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
RELAY_KEY=change-me-to-a-long-random-string

PORT=8080
HOST=0.0.0.0

# Where the Webshare list lives. Defaults to ./proxies.txt next to server.js.
# PROXY_FILE=/etc/rfm/proxies.txt
